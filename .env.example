# Django core
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,www.your-domain.com
DATABASE_URL=postgresql://user:password@host:5432/dbname
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://www.your-domain.com

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=RestaurApp <no-reply@your-domain.com>

# Django settings module (Render overrides this via environment variable)
DJANGO_SETTINGS_MODULE=restaurante.settings.production

# Superuser (used by build.sh on first deploy)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=change-this-strong-password
